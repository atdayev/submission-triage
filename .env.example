# Copy to .env and fill in. Loaded at startup; never overrides existing env vars.
# Every setting the service reads is listed. Only IMAP and SMTP need values.

SERVICE_NAME=submission-triage

# ─── HTTP ──────────────────────────────────────────────────────────────────
# /health only, not a public UI.
HTTP_PORT=8080
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=30
HTTP_SHUTDOWN_TIMEOUT_SECONDS=10
# /health reports the poller stale after poll_interval x this
HEALTH_POLL_STALE_MULTIPLIER=3

# ─── Storage ───────────────────────────────────────────────────────────────
# created on first run; back it up
DB_PATH=./data/submission-triage.db

# ─── Logging ───────────────────────────────────────────────────────────────
# LEVEL: debug|info|warn|error.  FORMAT: json|text.
LOG_LEVEL=info
LOG_FORMAT=json
# blank = stdout only; set a dir for rotating files
LOG_DIR=
# 0 is not "keep forever" — it falls back to 7 days
LOG_MAX_AGE_DAYS=14
LOG_ROTATION_HOURS=24

# ─── IMAP — inbox to watch (REQUIRED) ──────────────────────────────────────
# Off until HOST, USERNAME and PASSWORD are set. Gmail needs a 16-char App
# Password: https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@gmail.com
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_SECONDS=30
# over-cap messages are skipped and marked read
IMAP_MAX_MESSAGE_MB=32
# SET THIS on a mailbox with history (RFC3339), or the first run replies to every
# old unread email. Blank falls back to the first-boot timestamp.
IMAP_IGNORE_BEFORE=
IMAP_POLL_TIMEOUT_SECONDS=120
# give up on a message after this many failed attempts
POLL_MAX_ATTEMPTS=5

# ─── Mailbox folders ───────────────────────────────────────────────────────
# Each processed message is filed into <PREFIX>/<folder>. These names are what
# the agency sees in Gmail.
IMAP_FILE_BY_STATUS=true
IMAP_FOLDER_PREFIX=Triage
IMAP_FOLDER_COMPLETE=Ready for Underwriting
IMAP_FOLDER_AWAITING=Waiting on Broker
IMAP_FOLDER_ESCALATED=Escalated
IMAP_FOLDER_UNKNOWN_POLICY=Unknown Policy
# drag a message in here to pause its case; drag it out to resume
IMAP_FOLDER_HOLD=Hold
IMAP_HOLD_SCAN_LIMIT=200

# ─── SMTP — where replies are sent from (REQUIRED) ─────────────────────────
# Same mailbox/App Password as IMAP on Gmail. 587=STARTTLS, 465=implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=you@gmail.com
SMTP_FROM_NAME=Submission Triage
# smtp | log | blank (auto). "log" prints instead of sending.
OUTBOUND_PROVIDER=

# ─── Mail auth (OPTIONAL) ──────────────────────────────────────────────────
# "oauth" uses XOAUTH2 for both protocols and ignores the passwords above — for
# tenants that disallow app passwords.
MAIL_AUTH_MODE=password
# google | microsoft
MAIL_OAUTH_PROVIDER=
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=
# the mailbox address XOAUTH2 signs in as
MAIL_OAUTH_USER=
# microsoft only
MAIL_OAUTH_TENANT_ID=
# google only — mint one with: go run ./cmd/authorize
MAIL_OAUTH_REFRESH_TOKEN=

# ─── LLM — Anthropic (OPTIONAL) ────────────────────────────────────────────
# Identifies attachments the filename/keyword rules can't place. Without a key
# those rules pass on document presence.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_TOKENS=2048
# past the cap, identification degrades to filename matching for the rest of the
# UTC day. 0 disables.
LLM_DAILY_USD_CAP=10.00

# ─── Documents (OPTIONAL) ──────────────────────────────────────────────────
# below this a document is flagged for a human instead of satisfying its item
CLASSIFIER_CONFIDENCE_FLOOR=0.80
# a PDF at/above this size yielding fewer than MIN_CHARS chars is an unreadable scan
UNREADABLE_MIN_SIZE_BYTES=51200
UNREADABLE_MIN_CHARS=100
# named in a body with no attachments, these trigger the "attach directly" reply
ATTACHMENT_LINK_DOMAINS=sharefile,dropbox,wetransfer,box.com,drive.google,sharepoint,egnyte,hightail,smartvault

# ─── Checklists ────────────────────────────────────────────────────────────
# one YAML per policy type; edit or add, then restart
CHECKLISTS_DIR=./checklists

# ─── Escalation (OPTIONAL) ─────────────────────────────────────────────────
ESCALATION_INTERVAL_MINUTES=15
ESCALATION_THRESHOLD_HOURS=72
# 336 = 14 days
ESCALATION_AUTO_CLOSE_AFTER_HOURS=336
# 2160 = 90 days; without it a case nobody can act on stays open forever
AWAITING_AUTO_CLOSE_AFTER_HOURS=2160
# escalate as the effective date nears, regardless of quiet time
ESCALATION_BIND_WINDOW_DAYS=7
ESCALATION_BIND_GRACE_DAYS=3
ESCALATION_MIN_GAP_HOURS=24

# ─── Daily digest (OPTIONAL) ───────────────────────────────────────────────
DIGEST_INTERVAL_HOURS=24
# blank disables it — and it is the only status email there is
DIGEST_RECIPIENT=
DIGEST_MAX_ROWS=500

# ─── Threading (OPTIONAL) ──────────────────────────────────────────────────
# lookback for matching a new email to an existing case by insured + sender
THREAD_MATCH_WINDOW_DAYS=14

# ─── Retention (OPTIONAL) ──────────────────────────────────────────────────
# 0 disables the sweep and the database grows without bound
RETENTION_INTERVAL_HOURS=24
AUDIT_RETENTION_DAYS=90
# 168 = 7 days
OUTBOX_PENDING_TTL_HOURS=168

# ─── Safety valves (OPTIONAL) ──────────────────────────────────────────────
# false runs everything but sends brokers nothing. Nothing is sent later when it
# goes back on; skipped cases get their own digest heading.
REPLIES_ENABLED=true
# inbound emails allowed before an undetermined policy type is flagged for a
# human. NOT how many clarification emails go out — repeat suppression means one.
POLICY_CLARIFY_MAX_ASKS=3

# ─── Reply delivery (OPTIONAL) ─────────────────────────────────────────────
REPLY_WORKERS=4
REPLY_QUEUE_SIZE=64
# minimum spacing between replies on one case, so a burst collapses into one
REPLY_COALESCE_WINDOW_SECONDS=120
REPLY_FLUSH_INTERVAL_SECONDS=30

# ─── Retries (OPTIONAL) ────────────────────────────────────────────────────
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500

# ─── Deprecated ────────────────────────────────────────────────────────────
# Still read, but they warn at startup:
#   IMAP_COMPLETE_LABEL              -> IMAP_FOLDER_COMPLETE
#   ESCALATION_DIGEST_INTERVAL_HOURS -> DIGEST_INTERVAL_HOURS
#   ESCALATION_DIGEST_RECIPIENT      -> DIGEST_RECIPIENT
